{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "deepseek/deepseek-v4-pro": {
          "options": {
            "reasoning": { "enabled": false }
          }
        },
        "deepseek/deepseek-v4-flash": {
          "options": {
            "reasoning": { "enabled": false }
          }
        }
      }
    }
  },
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "small_model": "openrouter/deepseek/deepseek-v4-flash",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
  },
  "instructions": [
    "./rules/core/code-style.md",
    "./rules/core/secrets-and-pii.md",
    "./rules/core/research-first-citations.md",
    "./rules/core/intent-capture-required.md",
    "./rules/core/model-routing.md",
    "./rules/core/no-hardcoded-magic.md",
    "./rules/authoring/skill-authoring-required.md",
    "./rules/authoring/agent-authoring-required.md",
    "./rules/integrations/code-graph-usage.md"
  ]
}
