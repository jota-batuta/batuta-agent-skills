.DS_Store
node_modules/
.env
.env.*
*.log
.claude/.simplify-ignore-cache/
.claude/.authoring-marker-*
.claude/.intent-confirmed-*
.claude/.routing-confirmed-*
.claude/.intent-and-routing-confirmed-*
.claude/kb-debug.log
.claude/settings.json
.claude/settings.local.json
.vscode/
.claude/rules/
.aider.conf.yml
.claude/kb-config.json
graphify-out/

# opencode runtime artifacts (generated by `opencode` invocation).
# We ignore everything under .opencode/ that opencode may write at runtime,
# then explicitly un-ignore the curated tree we ship.
.opencode/.cache/
.opencode/sessions/
.opencode/node_modules/
.opencode/package-lock.json
.opencode/bun.lock
.opencode/build-log.md
.opencode/*.json
!.opencode/agents/
!.opencode/commands/
!.opencode/skills
